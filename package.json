{
    "private": true,
    "name": "remix-app-template",
    "description": "",
    "license": "",
    "scripts": {
        "build": "npm run build:css && remix build",
        "build:css": "tailwindcss -i ./css/tailwind.css -o ./app/tailwind.css --minify",
        "dev": "concurrently \"npm run dev:css\" \"cross-env NODE_ENV=development netlify dev\"",
        "dev:css": "tailwindcss -i ./css/tailwind.css -o ./app/tailwind.css --watch",
        "postinstall": "remix setup node",
        "start": "remix-serve build",
        "test": "jest"
    },
    "dependencies": {
        "@imgix/js-core": "^3.5.1",
        "@netlify/functions": "^0.10.0",
        "@remix-run/netlify": "^1.4.1",
        "@remix-run/node": "^1.4.1",
        "@remix-run/react": "^1.4.1",
        "@sendgrid/mail": "^7.6.0",
        "akismet-api": "^5.2.1",
        "classnames": "^2.3.1",
        "dotenv": "^10.0.0",
        "graphql": "^16.2.0",
        "graphql-request": "^3.7.0",
        "react": "^18.0.0",
        "react-dom": "^18.0.0",
        "remix": "^1.4.1"
    },
    "devDependencies": {
        "@babel/plugin-transform-runtime": "^7.17.0",
        "@babel/preset-env": "^7.16.11",
        "@babel/preset-react": "^7.16.7",
        "@babel/preset-typescript": "^7.16.7",
        "@remix-run/dev": "^1.4.1",
        "@testing-library/jest-dom": "^5.16.4",
        "@testing-library/react": "^13.1.1",
        "@testing-library/user-event": "^14.1.1",
        "@types/react": "^18.0.6",
        "@types/react-dom": "^18.0.2",
        "@viget/tailwindcss-plugins": "^0.0.11",
        "babel-jest": "^27.5.1",
        "concurrently": "^6.5.1",
        "cross-env": "^7.0.3",
        "eslint-config-prettier": "^8.3.0",
        "eslint-plugin-prettier": "^4.0.0",
        "jest": "^27.5.1",
        "prettier": "2.5.1",
        "react-test-renderer": "^18.0.0",
        "tailwindcss": "^3.0.8",
        "ts-jest": "^27.1.4",
        "typescript": "^4.1.2"
    },
    "engines": {
        "node": ">=14"
    },
    "sideEffects": false
}
